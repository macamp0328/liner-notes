# Wall 1: main is PR-only. GitHub branch protection enforces this server-side;
# this catches it before a commit ever lands locally (agents included).
branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$branch" = "main" ]; then
  echo "✗ Direct commits to main are blocked — create a task/fix/chore branch (CLAUDE.md §4.2)." >&2
  exit 1
fi

pnpm exec lint-staged
