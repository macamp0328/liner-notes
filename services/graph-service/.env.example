# Port for the HTTP server
PORT=3000

# Node environment
NODE_ENV=development

# ─────────────────────────────────────────
# Neo4j
# ─────────────────────────────────────────

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ─────────────────────────────────────────
# Neo4j — integration test database
# ─────────────────────────────────────────
# Used by `pnpm --filter graph-service test:integration`. REQUIRED — the
# integration harness has no NEO4J_* fallback; an unset var fails the suite fast,
# naming the missing one. An explicitly-set empty value IS honored (e.g. the empty
# password of the docker-compose Neo4j, which runs with NEO4J_AUTH=none).
#
# Set these in `.env.test.local` (gitignored) or export them in your shell — NOT
# `.env.local`, which dotenv-flow deliberately skips when NODE_ENV=test (Vitest
# sets it), so values there never reach the integration suite. Locally, point them
# at the docker-compose Neo4j (same host as NEO4J_* above; empty password).
NEO4J_TEST_URI=bolt://localhost:7687
NEO4J_TEST_USER=neo4j
NEO4J_TEST_PASSWORD=

# ─────────────────────────────────────────
# Discogs API
# ─────────────────────────────────────────

DISCOGS_USERNAME=
DISCOGS_TOKEN=
DISCOGS_USER_AGENT=liner-notes/1.0 +https://github.com/yourusername/liner-notes
DISCOGS_REQUEST_DELAY_MS=1000

# ─────────────────────────────────────────
# Application
# ─────────────────────────────────────────

ADMIN_TOKEN=

# Key the global rate limiter on Cloudflare's `cf-connecting-ip` header instead of the
# direct TCP peer. SECURITY: enable ONLY when a trusted proxy that *overwrites* this header
# (e.g. Cloudflare) fronts the service AND the origin rejects direct traffic (the CF-only
# security group, `restrict_app_to_cloudflare`). Otherwise any client can spoof
# `cf-connecting-ip` per request and bypass rate limiting entirely. Default off — local dev
# and plain-HTTP forks key on the real peer and need no change. See issue #287.
TRUST_CF_CONNECTING_IP=false

# ─────────────────────────────────────────
# MusicBrainz / Wikidata Enrichment
# ─────────────────────────────────────────

# Polite User-Agent for MusicBrainz and Wikidata requests. Required —
# without this, the admin enrichment endpoints (nationality, track-musicbrainz,
# mb-release-events) return 503. Format: "<app>/<version> ( <contact> )".
MUSICBRAINZ_USER_AGENT=liner-notes/1.0 +https://github.com/yourusername/liner-notes

# ─────────────────────────────────────────
# Lyrics Enrichment
# ─────────────────────────────────────────
#
# LRCLIB (free, no key) is the primary source and the only one prod uses. Set GENIUS_TOKEN only
# in a LOCAL env file for the operator-run residential harvest — Genius 403s the prod datacenter
# IP (#240), so prod leaves it unset. See infra/RUNBOOK.md "Harvest Genius lyrics locally" and
# `pnpm lyrics:enrich:local`.
GENIUS_TOKEN=

# User-Agent for Genius requests (local harvest only). Must look like a real browser — Genius's
# Cloudflare edge 403s bot-like or empty UAs from datacenter IPs (issue #195). Optional; defaults
# to a current Chrome UA. Override only to refresh the string without a code change.
GENIUS_USER_AGENT=

# Identifying User-Agent for LRCLIB requests. LRCLIB's API explicitly asks callers to send an
# app-name/version/contact string (a polite identifier, not a browser disguise). Optional —
# defaults to a liner-notes identifier.
LRCLIB_USER_AGENT=

# Per-request spacing (ms) the LRCLIB client sleeps after each successful call. Optional —
# defaults to 0 because LYRICS_CONCURRENCY is the stage's rate ceiling; raise it only to throttle
# each worker further. Malformed/negative values fall back to the default.
# LRCLIB_REQUEST_DELAY_MS=0

# How many tracks the lyrics stage looks up in parallel (#247). The lyrics stage is the pipeline's
# slowest step; bounded concurrency IS its rate ceiling (no separate limiter), so this doubles as
# the politeness knob toward LRCLIB. Defaults to 6; clamped to [1, 12]. Set to 1 for strictly
# serial. Non-numeric/unset falls back to 6.
# LYRICS_CONCURRENCY=6

# Bounded in-run retry sweep for transient lyrics failures (#455). After the lyrics stage's main
# pass, transient LRCLIB failures (timeouts, 5xx) are re-attempted for this many rounds with a short
# escalating backoff, so a transient blip during a fresh reload recovers in-run instead of leaving a
# durable not-found gap (a fresh reload has no later staleness window in the same run). Defaults to
# 2; set 0 to disable the sweep. Negative/non-numeric falls back safely (0 / default).
# LYRICS_RETRY_ROUNDS=2

# ─────────────────────────────────────────
# AcousticBrainz Enrichment (optional)
# ─────────────────────────────────────────

# Polite User-Agent for AcousticBrainz requests.
# AcousticBrainz requires no API key; this header is optional but courteous.
# Defaults to liner-notes/1.0 when unset.
ACOUSTICBRAINZ_USER_AGENT=liner-notes/1.0 +https://github.com/yourusername/liner-notes

# ─────────────────────────────────────────
# Circuit breaker (external API data collection)
# ─────────────────────────────────────────
#
# Each external source (MusicBrainz, AcousticBrainz, Deezer, Wikidata, Genius, LRCLIB) gets a
# per-run circuit breaker. After this many CONSECUTIVE fatal/blocked responses (401/403/451 or a
# bot-block HTML challenge — NOT 404 misses or transient 429/5xx) the source is skipped for the
# rest of the run and the trip is logged once at warn. Default 5; a high value effectively disables
# tripping. Discogs (the critical ingest path) is opt-out by default.
CIRCUIT_BREAKER_THRESHOLD=5

# Optional half-open probe: ms to stay open before allowing ONE trial request to test recovery.
# Unset (default) = stay open for the whole run — the right choice for a datacenter-IP block or
# expired token, which won't recover mid-run.
CIRCUIT_BREAKER_COOLDOWN_MS=

# ─────────────────────────────────────────
# Outbound HTTP request timeout
# ─────────────────────────────────────────
#
# Per-request timeout (ms) for every outbound API call (Discogs, MusicBrainz, AcousticBrainz,
# Deezer, LRCLIB, Genius, Wikidata), bounding a stalled upstream well under undici's ~300s default.
# Unset (default): standard clients use 30000 and the bulk MusicBrainz/AcousticBrainz clients 60000.
# Setting this overrides ALL clients; a malformed or non-positive value falls back to the per-client
# default. A timeout is recorded as a transient circuit-breaker outcome and fails fast (it is not
# retried — the enrichment staleness window retries un-stamped items on the next run).
# OUTBOUND_REQUEST_TIMEOUT_MS=30000
