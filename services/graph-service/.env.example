# Port for the HTTP server
PORT=3000

# Node environment
NODE_ENV=development

# ─────────────────────────────────────────
# Neo4j
# ─────────────────────────────────────────

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ─────────────────────────────────────────
# Discogs API
# ─────────────────────────────────────────

DISCOGS_USERNAME=
DISCOGS_TOKEN=
DISCOGS_USER_AGENT=liner-notes/1.0 +https://github.com/yourusername/liner-notes
DISCOGS_REQUEST_DELAY_MS=1000

# ─────────────────────────────────────────
# Application
# ─────────────────────────────────────────

ADMIN_TOKEN=

# ─────────────────────────────────────────
# MusicBrainz / VIAF / Wikidata Enrichment
# ─────────────────────────────────────────

# Polite User-Agent for MusicBrainz, VIAF, and Wikidata requests. Required —
# without this, the admin enrichment endpoints (nationality, track-musicbrainz,
# mb-release-events) return 503. Format: "<app>/<version> ( <contact> )".
MUSICBRAINZ_USER_AGENT=liner-notes/1.0 +https://github.com/yourusername/liner-notes

# ─────────────────────────────────────────
# Lyrics Enrichment (optional)
# ─────────────────────────────────────────

GENIUS_TOKEN=

# ─────────────────────────────────────────
# AcousticBrainz Enrichment (optional)
# ─────────────────────────────────────────

# Polite User-Agent for AcousticBrainz requests.
# AcousticBrainz requires no API key; this header is optional but courteous.
# Defaults to liner-notes/1.0 when unset.
ACOUSTICBRAINZ_USER_AGENT=liner-notes/1.0 +https://github.com/yourusername/liner-notes
