# Port for the HTTP server
PORT=3000

# Node environment
NODE_ENV=development

# ─────────────────────────────────────────
# Neo4j
# ─────────────────────────────────────────

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ─────────────────────────────────────────
# Discogs API
# ─────────────────────────────────────────

DISCOGS_USERNAME=
DISCOGS_TOKEN=
DISCOGS_USER_AGENT=liner-notes/1.0 +https://github.com/yourusername/liner-notes
DISCOGS_REQUEST_DELAY_MS=1000

# ─────────────────────────────────────────
# Application
# ─────────────────────────────────────────

ADMIN_TOKEN=

# ─────────────────────────────────────────
# Lyrics Enrichment (optional)
# ─────────────────────────────────────────

GENIUS_TOKEN=

# ─────────────────────────────────────────
# Spotify Audio Features Enrichment (optional)
# ─────────────────────────────────────────

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REQUEST_DELAY_MS=100
