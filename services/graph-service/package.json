{
  "name": "@liner-notes/graph-service",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run tests/unit tests/route --passWithNoTests",
    "test:unit:coverage": "vitest run --coverage tests/unit tests/route",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:load": "tsx tests/load/api.load.ts",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "docs:generate": "tsx scripts/generate-openapi.ts && prettier --write docs/openapi.json"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.1.0",
    "@fastify/swagger-ui": "^5.1.0",
    "dotenv-flow": "^4.1.0",
    "fastify": "^5.1.0",
    "neo4j-driver": "^6.1.0"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.8",
    "autocannon": "^8.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
