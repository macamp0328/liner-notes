              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "discogsId",
                        "title",
                        "artists",
                        "labels",
                        "genres",
                        "styles",
                        "studios",
                        "tracks",
                        "credits"
