# Environment
.env
.env.local
.env.*.local
.env.production

# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor
.vscode/settings.json
.idea/
*.swp
*.swo

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl
tfplan
# Real tfvars may carry IP allowlists / SSH key names — keep them local.
# The committed terraform.tfvars.example documents the available knobs.
*.tfvars
!*.tfvars.example
# Lambda deployment package — built from lambda/*.py by archive_file on plan.
infra/terraform/lambda/*.zip


# Test coverage
coverage/
.vitest-cache/

# Claude Code
#
# Track shared project workflows (skills, hooks). Ignore personal state
# and transient agent scratch space:
#   - settings.local.json holds per-developer overrides (Claude convention)
#   - worktrees/ is where agents check out branches for parallel work
#   - .DS_Store is macOS Finder noise
.claude/.DS_Store
.claude/settings.local.json
.claude/worktrees/

# pnpm local store (created when PNPM_STORE_DIR points inside the repo)
.pnpm-store/
