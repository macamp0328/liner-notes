#!/usr/bin/env bash
# Validate Conventional Commits format per @commitlint/config-conventional.
# Rule: subject-case never [sentence-case, start-case, pascal-case, upper-case]
# In practice: the character after "type: " must be lowercase.
#
# Install: cp scripts/hooks/commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg
MSG=$(head -1 "$1")

# Skip merge commits
[[ "$MSG" == Merge\ * ]] && exit 0

PATTERN='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\(.+\))?!?: [a-z]'
if ! [[ "$MSG" =~ $PATTERN ]]; then
  echo ""
  echo "  commit-msg: Conventional Commits violation"
  echo "  Header: $MSG"
  echo ""
  echo "  Format:  type(scope)?: subject"
  echo "  Types:   build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test"
  echo "  Subject: must start with a lowercase letter (not OpenAPI, not Fix, not Add)"
  echo ""
  exit 1
fi
