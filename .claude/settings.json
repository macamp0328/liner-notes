{
  "permissions": {
    "deny": [
      "Read(./.env.local)",
      "Read(**/.env.local)",
      "Read(./.env.production)",
      "Read(**/.env.production)",
      "Read(./.env.production.local)",
      "Read(**/.env.production.local)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/.terraform/**)"
    ],
    "ask": ["Bash(terraform apply:*)", "Bash(terraform destroy:*)", "Bash(kubectl delete:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bash-guard.sh"
          }
        ]
      }
    ]
  }
}
