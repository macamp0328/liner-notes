{
  "name": "liner-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "test": "pnpm -r test",
    "lint": "eslint services/graph-service/src services/graph-service/tests services/graph-service/scripts \"services/graph-service/*.config.ts\" scripts --ext .ts --max-warnings 0",
    "markdownlint": "markdownlint-cli2",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "mask:check": "bash scripts/check-mask.sh",
    "verify": "prettier --check . && pnpm markdownlint && pnpm lint && pnpm typecheck && pnpm --filter graph-service test:unit:coverage && pnpm scripts:test && pnpm mask:check",
    "diagrams:generate": "tsx scripts/diagrams/generate.ts",
    "changelog:update": "tsx scripts/changelog/update.ts",
    "changelog:reconcile": "tsx scripts/changelog/reconcile.ts",
    "changelog:backfill": "tsx scripts/changelog/backfill.ts",
    "changelog:release": "tsx scripts/changelog/release.ts",
    "changelog:baseline": "tsx scripts/changelog/release.ts --baseline",
    "changelog:test": "tsx --test scripts/changelog/*.test.ts",
    "insomnia:generate": "pnpm --filter graph-service docs:generate && tsx scripts/insomnia/generate.ts && prettier --write services/graph-service/docs/insomnia.collection.yaml",
    "schema:diagram": "tsx scripts/schema-diagram/generate.ts",
    "schema:page": "tsx scripts/schema-diagram/build-page.ts",
    "enrich:lyrics": "scripts/admin/post.sh /api/v1/admin/lyrics/enrich",
    "enrich:master-data": "scripts/admin/post.sh /api/v1/admin/master-data/enrich",
    "enrich:nationality": "scripts/admin/post.sh /api/v1/admin/nationality/enrich",
    "enrich:mb-release-events": "scripts/admin/post.sh /api/v1/admin/mb-release-events/enrich",
    "enrich:track-musicbrainz": "scripts/admin/post.sh /api/v1/admin/track-musicbrainz/enrich",
    "enrich:track-acousticbrainz": "scripts/admin/post.sh /api/v1/admin/track-acousticbrainz/enrich",
    "enrich:track-deezer": "scripts/admin/post.sh /api/v1/admin/track-deezer/enrich",
    "enrich:bootstrap": "pnpm enrich:mb-release-events && pnpm enrich:track-musicbrainz && ( pnpm enrich:track-acousticbrainz & p1=$!; pnpm enrich:track-deezer & p2=$!; wait $p1; s1=$?; wait $p2; s2=$?; [ $s1 -eq 0 ] && [ $s2 -eq 0 ] ) && pnpm enrich:nationality",
    "lyrics:enrich:local": "pnpm --filter graph-service exec tsx scripts/lyrics-enrich-local.ts",
    "lyrics:enrich:prod": "pnpm --filter graph-service exec tsx scripts/lyrics-enrich-local.ts --env .env.prod.local",
    "status:lyrics": "scripts/admin/get.sh /api/v1/admin/lyrics/status",
    "status:master-data": "scripts/admin/get.sh /api/v1/admin/master-data/status",
    "status:nationality": "scripts/admin/get.sh /api/v1/admin/nationality/status",
    "status:mb-release-events": "scripts/admin/get.sh /api/v1/admin/mb-release-events/status",
    "status:track-musicbrainz": "scripts/admin/get.sh /api/v1/admin/track-musicbrainz/status",
    "status:track-acousticbrainz": "scripts/admin/get.sh /api/v1/admin/track-acousticbrainz/status",
    "status:track-deezer": "scripts/admin/get.sh /api/v1/admin/track-deezer/status",
    "db:wipe": "scripts/admin/post.sh '/api/v1/admin/reset?confirm=wipe-all'",
    "power:on": "scripts/admin/power.sh on",
    "power:off": "scripts/admin/power.sh off",
    "power:auto": "scripts/admin/power.sh auto",
    "power:status": "scripts/admin/power.sh status",
    "prepare": "if [ -f scripts/prepare.sh ]; then sh scripts/prepare.sh; fi",
    "prepare:test": "tsx --test scripts/prepare.test.ts",
    "scripts:test": "tsx --test 'scripts/**/*.test.ts'"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "pnpm": {
    "overrides": {
      "uuid": "^11.1.1",
      "esbuild": "^0.28.1",
      "form-data": "^4.0.6",
      "js-yaml@^4.0.0": ">=4.2.0 <5",
      "markdown-it@<14.2.0": ">=14.2.0"
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.107.0",
    "@types/node": "^26",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-plugin-security": "4.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "markdownlint-cli2": "0.22.1",
    "neo4j-driver": "^6.1.0",
    "prettier": "^3.9.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  }
}
