{
  "name": "liner-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "diagrams:generate": "tsx scripts/diagrams/generate.ts",
    "enrich:lyrics": "scripts/admin/post.sh /api/v1/admin/lyrics/enrich",
    "enrich:master-data": "scripts/admin/post.sh /api/v1/admin/master-data/enrich",
    "enrich:nationality": "scripts/admin/post.sh /api/v1/admin/nationality/enrich",
    "enrich:mb-release-events": "scripts/admin/post.sh /api/v1/admin/mb-release-events/enrich",
    "enrich:track-musicbrainz": "scripts/admin/post.sh /api/v1/admin/track-musicbrainz/enrich",
    "enrich:track-acousticbrainz": "scripts/admin/post.sh /api/v1/admin/track-acousticbrainz/enrich",
    "enrich:track-deezer": "scripts/admin/post.sh /api/v1/admin/track-deezer/enrich",
    "enrich:bootstrap": "pnpm enrich:mb-release-events && pnpm enrich:track-musicbrainz && ( pnpm enrich:track-acousticbrainz & pnpm enrich:track-deezer & wait ) && pnpm enrich:nationality",
    "lyrics:enrich:local": "pnpm --filter graph-service exec tsx scripts/lyrics-enrich-local.ts",
    "status:lyrics": "scripts/admin/get.sh /api/v1/admin/lyrics/status",
    "status:master-data": "scripts/admin/get.sh /api/v1/admin/master-data/status",
    "status:nationality": "scripts/admin/get.sh /api/v1/admin/nationality/status",
    "status:mb-release-events": "scripts/admin/get.sh /api/v1/admin/mb-release-events/status",
    "status:track-musicbrainz": "scripts/admin/get.sh /api/v1/admin/track-musicbrainz/status",
    "status:track-acousticbrainz": "scripts/admin/get.sh /api/v1/admin/track-acousticbrainz/status",
    "status:track-deezer": "scripts/admin/get.sh /api/v1/admin/track-deezer/status",
    "db:wipe": "scripts/admin/post.sh '/api/v1/admin/reset?confirm=wipe-all'",
    "power:on": "scripts/admin/power.sh on",
    "power:off": "scripts/admin/power.sh off",
    "power:auto": "scripts/admin/power.sh auto",
    "power:status": "scripts/admin/power.sh status",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-plugin-security": "4.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.3.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
