# Optional overrides for the production deploy.
#
# All variables here have defaults in variables.tf — copy this file to
# `terraform.tfvars` only if you want to deviate from those defaults. The
# default flow (`terraform apply` with no tfvars) is a sensible starting point.

# AWS region. Must match the `region:` field in
# infra/k8s/graph-service/external-secret.yaml and the AWS_REGION env in
# ecr-pull-secret-refresher.yaml — see runbook step 7.
# aws_region = "us-east-1"

# Default is t3.small (2 vCPU / 2 GB). t3.micro (1 GB) is too tight for
# k3s + ESO + graph-service — the API server starts dropping requests
# under any concurrent load. Bump higher (t3.medium, t3.large) if you
# add more services or push significantly more traffic.
# instance_type = "t3.small"

# Narrow which IPs can reach the graph-service NodePort (30080).
# Default is wide open ("0.0.0.0/0"); set to your home/office IP for tighter
# exposure. The repo's auth model (ADMIN_TOKEN on mutating endpoints, public
# reads) still applies on top of this.
# allow_app_cidr = ["203.0.113.42/32"]

# SSH access. Default is disabled — use AWS Session Manager
# (`aws ssm start-session --target <instance-id>`) instead, which doesn't
# need a key pair or an open port. If you want SSH anyway:
# ssh_key_name   = "my-keypair"
# allow_ssh_cidr = ["203.0.113.42/32"]

# Scale-to-zero power switch (see infra/RUNBOOK.md). The Lambda and schedules
# are always created; these only tune the nightly cost-saver. The runtime
# switch (`pnpm power:on|off|auto`) owns the schedule state after first apply.
#
# Start the node sleeping on the nightly schedule out of the box (default is
# manual control — schedules created DISABLED):
# nightly_schedule_enabled = true
#
# Stop/start times. Crons are evaluated in scheduler_timezone (DST-aware).
# scheduler_timezone   = "America/New_York"
# scheduler_stop_cron  = "cron(0 23 * * ? *)"
# scheduler_start_cron = "cron(0 8 * * ? *)"
