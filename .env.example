# ─────────────────────────────────────────
# Discogs API
# ─────────────────────────────────────────

# Your Discogs username (e.g. the one in your collection URL)
DISCOGS_USERNAME=

# Personal access token — generate at https://www.discogs.com/settings/developers
# Also used by nationality enrichment as a third-tier fallback: fetches the Discogs artist
# page to extract Wikipedia URLs, which are then resolved via Wikidata (schema:about triple).
DISCOGS_TOKEN=

# User-Agent sent with every Discogs request (required by their API terms)
DISCOGS_USER_AGENT=liner-notes/1.0 +https://github.com/yourusername/liner-notes

# Delay in milliseconds between Discogs API requests (respect 60 req/min limit)
DISCOGS_REQUEST_DELAY_MS=1000

# ─────────────────────────────────────────
# Neo4j
# ─────────────────────────────────────────

# Neo4j Aura connection URI (e.g. neo4j+s://xxxxxxxx.databases.neo4j.io)
NEO4J_URI=

# Neo4j username (Aura default: neo4j)
NEO4J_USER=neo4j

# Neo4j password set during Aura instance creation
NEO4J_PASSWORD=

# ─────────────────────────────────────────
# Application
# ─────────────────────────────────────────

# Port for the graph-service HTTP server
PORT=3000

# Node environment
NODE_ENV=development

# Secret token required for admin endpoints (POST /api/v1/admin/ingest)
ADMIN_TOKEN=

# ─────────────────────────────────────────
# MusicBrainz
# ─────────────────────────────────────────

# No API key required — MusicBrainz is free and open.
# A descriptive User-Agent is required by their API terms of service.
# Format: AppName/Version (contact-email)
# Also used as the User-Agent for VIAF (Virtual International Authority File) requests,
# which has the same "app name + contact" identification requirement.
MUSICBRAINZ_USER_AGENT=liner-notes/1.0 (your-email@example.com)

# ─────────────────────────────────────────
# Lyrics Enrichment (optional)
# ─────────────────────────────────────────

# LRCLIB is free and requires no key — used as primary source
# Genius API key for lyrics fallback — https://genius.com/api-clients
GENIUS_TOKEN=
