# ─────────────────────────────────────────
# Discogs API
# ─────────────────────────────────────────

# Your Discogs username (e.g. the one in your collection URL)
DISCOGS_USERNAME=

# Personal access token — generate at https://www.discogs.com/settings/developers
# Also used by nationality enrichment as a third-tier fallback: fetches the Discogs artist
# page to extract Wikipedia URLs, which are then resolved via Wikidata (schema:about triple).
DISCOGS_TOKEN=

# User-Agent sent with every Discogs request (required by their API terms)
DISCOGS_USER_AGENT=liner-notes/1.0 +https://github.com/yourusername/liner-notes

# Delay in milliseconds between Discogs API requests (respect 60 req/min limit)
DISCOGS_REQUEST_DELAY_MS=1000

# ─────────────────────────────────────────
# Neo4j
# ─────────────────────────────────────────

# Neo4j Aura connection URI (e.g. neo4j+s://xxxxxxxx.databases.neo4j.io)
NEO4J_URI=

# Neo4j username (Aura default: neo4j)
NEO4J_USER=neo4j

# Neo4j password set during Aura instance creation
NEO4J_PASSWORD=

# ─────────────────────────────────────────
# Neo4j — integration test database
# ─────────────────────────────────────────
# Used by `pnpm --filter graph-service test:integration` (vitest.integration.config.ts).
# REQUIRED — the integration harness has no NEO4J_* fallback. If any of these is
# unset the suite fails fast naming the missing var (an explicitly-set empty value,
# e.g. an empty password for NEO4J_AUTH=none, is honored).
#
# IMPORTANT — single-database constraint:
#   Both the CI neo4j:5 image (Community edition) and Neo4j Aura Free support
#   only the single default "neo4j" database. You CANNOT run
#   `CREATE DATABASE test` — on the CI image it fails with "not supported on
#   Community". Test isolation is by connection/instance (point these vars at a
#   separate Neo4j instance or the CI service container) plus a full graph wipe
#   (`MATCH (n) DETACH DELETE n`) between test files.
#
# Locally: point these at the docker-compose Neo4j (same host/credentials as the
#   NEO4J_* values above), or spin up a second local instance on a different port.
#   Set them in `.env.test.local` (gitignored) or export them in your shell —
#   NOT `.env.local`, which dotenv-flow deliberately skips when NODE_ENV=test
#   (Vitest sets it), so values there never reach the integration suite.
# In CI: the tests-and-coverage job injects these from the neo4j service container.
NEO4J_TEST_URI=bolt://localhost:7687
NEO4J_TEST_USER=neo4j
NEO4J_TEST_PASSWORD=

# ─────────────────────────────────────────
# Application
# ─────────────────────────────────────────

# Port for the graph-service HTTP server
PORT=3000

# Node environment
NODE_ENV=development

# Secret token required for admin endpoints (POST /api/v1/admin/ingest).
# Optional in dev/test (admin routes answer 503 without it); REQUIRED when
# NODE_ENV=production — the server refuses to start without it.
ADMIN_TOKEN=

# Max requests per client IP per minute for the global rate limiter. Defaults to
# 100 when unset; an unbounded cap is used under NODE_ENV=test. Behind a SNATing
# proxy/NodePort callers may share a bucket — Cloudflare now fronts the service as
# the edge defence (#119).
RATE_LIMIT_MAX=100

# Base URL used by the `pnpm enrich:*` / `pnpm status:*` admin scripts
# (scripts/admin/{post,get}.sh). Defaults to http://localhost:3000 when unset.
# For prod, use the deployed `service_url` — the Cloudflare HTTPS domain when
# enabled (`terraform -chdir=infra/terraform output -raw service_url`). The raw
# NodePort http://<EC2_IP>:30080 is refused once the origin is locked to
# Cloudflare (#119).
GRAPH_SERVICE_URL=http://localhost:3000

# Per-request timeout (seconds) for the admin scripts' curl calls (scripts/admin/{post,get}.sh).
# Defaults to 120 when unset. Enrich routes return 202 immediately (#280), so this mainly bounds a
# hung origin; raise it only for a rare long synchronous call (e.g. a large db:wipe).
CURL_MAX_TIME=120

# Production base URL baked into the *Production* sub-environment of the
# generated Insomnia collection (`pnpm insomnia:generate`). Defaults to the
# reference deployment's domain when unset. Forks: set this to your own
# domain when regenerating, AND add the same value as a GitHub repo variable
# named PROD_API_URL — the drift-check workflow (.github/workflows/insomnia.yml)
# regenerates with that variable, so a local-only override fails CI.
# PROD_API_URL=https://your-api.example.com

# Interval (ms) between background graph-stats snapshots — structured log lines
# that feed the "Collection over time" dashboard widgets (collection size and
# enrichment coverage % over time). Defaults to 21600000 (6h); a snapshot is
# also emitted once on startup. Lower it for finer-grained coverage trends.
# Each snapshot runs real Cypher, so it doubles as the Aura keep-warm ping
# (see infra/RUNBOOK.md "Keeping Aura warm"); it is therefore capped at 24h so
# it always stays inside AuraDB Free's 72h auto-pause window.
STATS_SNAPSHOT_INTERVAL_MS=21600000

# ─────────────────────────────────────────
# Changelog (CI / scripts only)
# ─────────────────────────────────────────
#
# Anthropic API key used by the changelog generator (scripts/changelog/*, run by
# .github/workflows/changelog.yml on merge and changelog-reconcile.yml weekly) to
# turn each merged PR into a plain-English sentence. NOT used by the graph-service
# runtime. In CI it comes from the `ANTHROPIC_API_KEY` repo secret
# (`gh secret set ANTHROPIC_API_KEY`). Locally, put it in `.env.local` (gitignored)
# — the `pnpm changelog:*` scripts auto-load `.env.local` then `.env`, so no manual
# `export` is needed. If UNSET the scripts still work — they fall back to a cleaned
# PR title instead of a Claude summary (and re-running backfill once the key is set
# upgrades those title-only entries). Optional override: CHANGELOG_MODEL (defaults
# to claude-opus-4-8; set claude-haiku-4-5 to save cost).
# ANTHROPIC_API_KEY=
# CHANGELOG_MODEL=claude-opus-4-8

# ─────────────────────────────────────────
# MusicBrainz
# ─────────────────────────────────────────

# No API key required — MusicBrainz is free and open.
# A descriptive User-Agent is required by their API terms of service.
# Format: AppName/Version (contact-email)
# Also used as the User-Agent for Wikidata requests, which have the same
# "app name + contact" identification requirement.
MUSICBRAINZ_USER_AGENT=liner-notes/1.0 (your-email@example.com)

# User-Agent for AcousticBrainz requests (same identification etiquette).
# Optional — defaults to "liner-notes/1.0" when unset.
ACOUSTICBRAINZ_USER_AGENT=liner-notes/1.0 (your-email@example.com)

# ─────────────────────────────────────────
# Lyrics Enrichment
# ─────────────────────────────────────────
#
# LRCLIB (free, no key) is the primary source and the ONLY one prod uses — leave GENIUS_TOKEN
# UNSET in prod. Genius's Cloudflare edge 403s the prod datacenter IP (#240), so the fallback
# lands 0 there; it is harvested out-of-band instead. Set GENIUS_TOKEN only in a LOCAL env file
# for the operator-run residential harvest (`pnpm lyrics:enrich:local`; see infra/RUNBOOK.md
# "Harvest Genius lyrics locally"). https://genius.com/api-clients
GENIUS_TOKEN=

# User-Agent for Genius requests (local harvest only). Must look like a real browser — Genius's
# Cloudflare edge 403s bot-like or empty UAs from datacenter IPs (issue #195). Optional —
# defaults to a current Chrome UA. Override only to refresh the string without a code change.
GENIUS_USER_AGENT=

# Identifying User-Agent for LRCLIB requests. LRCLIB's API explicitly asks callers to send an
# app-name/version/contact string (unlike Genius, this is a polite identifier, not a browser
# disguise). Optional — defaults to a liner-notes identifier. Override to add your own contact.
LRCLIB_USER_AGENT=

# Per-request spacing (ms) the LRCLIB client sleeps after each successful call. Optional —
# defaults to 0 because LYRICS_CONCURRENCY is the stage's rate ceiling; raise it only to throttle
# each worker further. Malformed/negative values fall back to the default.
# LRCLIB_REQUEST_DELAY_MS=0

# How many tracks the lyrics stage looks up in parallel (#247). The lyrics stage is the pipeline's
# slowest step; bounded concurrency IS its rate ceiling (there is no separate limiter), so this
# doubles as the politeness knob toward LRCLIB. Defaults to 6; clamped to [1, 12]. Set to 1 for the
# old strictly-serial behaviour. Non-numeric/unset falls back to 6.
# LYRICS_CONCURRENCY=6

# Match-confidence gate for storing lyrics (#248). A candidate's title/artist similarity and
# duration agreement are scored to [0, 1]; at or above this threshold the lyrics are stored
# `resolved`, below it the track is marked `low-confidence` (lyrics dropped, provenance kept). This
# is what blocks the wrong-song corruption class. Defaults to 0.85; a value outside [0, 1] or
# non-numeric/unset falls back to 0.85 (fails safe — never silently accepts or rejects everything).
# LYRICS_CONFIDENCE_THRESHOLD=0.85

# ─────────────────────────────────────────
# Outbound HTTP request timeout (optional)
# ─────────────────────────────────────────

# Per-request timeout (ms) for every outbound API call (Discogs, MusicBrainz, AcousticBrainz,
# Deezer, LRCLIB, Genius, Wikidata), bounding a stalled upstream well under undici's ~300s default.
# Unset (default): standard clients use 30000 and the bulk MusicBrainz/AcousticBrainz clients 60000.
# Setting this overrides ALL clients; a malformed or non-positive value falls back to the per-client
# default. A timeout is recorded as a transient circuit-breaker outcome and fails fast (it is not
# retried — the enrichment staleness window retries un-stamped items on the next run).
# OUTBOUND_REQUEST_TIMEOUT_MS=30000

# ─────────────────────────────────────────
# Enrichment re-try window (optional)
# ─────────────────────────────────────────

# How many days before a node whose external-source lookup found nothing is retried.
# Every enrichment skips nodes that already have the data and re-attempts a still-missing
# node at most once per this window — so a source that gains coverage (or a client we later
# fix) is picked up without a full re-ingest. Must be a non-negative integer; negative,
# non-numeric, or unset falls back to 30. Set it low (e.g. 1) to force more aggressive retries
# when testing; set it to 0 to re-attempt EVERY still-missing node regardless of last attempt
# (this is what the local Genius lyrics harvest uses — see infra/RUNBOOK.md).
# ENRICHMENT_STALENESS_DAYS=30

# ─────────────────────────────────────────
# Orchestrated reload concurrency (optional)
# ─────────────────────────────────────────

# How many reload stages may run at once (POST /api/v1/admin/reload). Stages are scheduled
# with bounded concurrency, respecting per-stage dependencies and resource lanes (shared API
# rate limiters, batched-Track node-lock exclusion), so independent stages overlap and the
# #165 gate metrics finish without waiting on the slow lyrics / track-musicbrainz stages.
# Defaults to 2 (modest for Aura Free + the single t3.small node); clamped to [1, stage count].
# Set to 1 for the legacy strictly-sequential behaviour. Non-numeric/unset falls back to 2.
# This deployment sets 3 via the k8s manifest (#370) so the untagged `lyrics` stage overlaps the
# Discogs ingest chain; note `nationality` holds the `discogs` lane, so it stays the reload tail
# regardless of this cap (concurrency alone won't move it earlier).
# RELOAD_STAGE_CONCURRENCY=2

# Lyrics worker count used ONLY when the lyrics stage runs inside the orchestrated reload (#372).
# A reload runs lyrics alongside other heavy stages, and the cross-stage DB/API contention inflates
# the transient LRCLIB failure rate (those misses self-heal on the next staleness window, but a
# single reload then lands below steady-state — see infra/RUNBOOK.md "Full reload from scratch").
# Set this below LYRICS_CONCURRENCY to throttle lyrics during a reload without slowing standalone
# `/lyrics/enrich` runs. Clamped to [1, 12]; non-numeric/unset falls back to LYRICS_CONCURRENCY (6).
# RELOAD_LYRICS_CONCURRENCY=3

# Hours after which a reload job still `running` in Neo4j with no live pod on it is reported
# `stale: true` by GET /api/v1/admin/reload/status (#326) — a stuck job (crash/missing-creds cold
# start) the operator can clear with POST /api/v1/admin/reload/abort without a pod restart. Default
# 12 (well above a full reload's ~4–6h, so a legitimately-long live run never trips it). Non-numeric
# /unset falls back to 12. Only affects the status flag; abort works regardless of age.
# RELOAD_STALE_AFTER_HOURS=12

# How many terminal (complete/failed) reload jobs to retain (#355). After each reload finishes,
# finishReloadJob prunes older terminal ReloadJob checkpoints (+ their ReloadStage children) beyond
# the newest N, so they don't accumulate forever (~14 nodes/reload). A running/resumable job is never
# pruned. Default 10; floored at 1 (the just-finished job always survives). Non-numeric/unset falls
# back to 10.
# RELOAD_JOB_HISTORY_KEEP=10

# ─────────────────────────────────────────
# Scale-to-zero power switch (optional)
# ─────────────────────────────────────────
# Used only by `pnpm power:on|off|auto|status` (scripts/admin/power.sh), which
# invokes the instance-scheduler Lambda. All optional — defaults work for the
# stock single-region deploy. See infra/RUNBOOK.md.
#
# AWS region the Lambda lives in (defaults to us-east-1 when unset).
# AWS_REGION=us-east-1
# Override only if you changed project_name in terraform (default name is
# <project_name>-instance-scheduler).
# SCHEDULER_LAMBDA_NAME=liner-notes-instance-scheduler
# AWS CLI profile to invoke with, if not your default profile.
# AWS_PROFILE=
